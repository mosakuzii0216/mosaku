# ローカル: docker compose の Postgres (localhost:5432)
# 本番：Supabase の Session Pooler 接続文字列(ダッシュボードの Connect から取得)
DATABASE_URL=

# 本番は production。Cookie の　Secure フラグがこれで切り替わる。
NODE_ENV=

# openssl rand -base 64 32 で生成。変えると全Cookieが無効になる
COOKIE_SECRET=

# パスキーのRP ID。ページのドメイン。ローカルはlocalhost、本番はmosaku.jp
RP_ID=

# パスキー検証に使うページのURL。ローカルはhttp://localhost:5173、本番はhttps://mosaku.jp
RP_ORIGIN=

# Googleログイン。Google Cloud → Google Auth Platform → クライアントで発行
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Googleから戻ってくる先。Google側に登録したURIと一字一句同じにする
GOOGLE_REDIRECT_URI=

# ログインが終わった後に戻す画面。ローカルはhttp://localhost:5173、本番はhttps://mosaku.jp
FRONTEND_URL=

# どのAIを使うか。claude か gemini。書かなければお試しのAI(お金はかからない)
AI_PROVIDER=

# Claudeのキー。Claude Console の API Keys で発行する
ANTHROPIC_API_KEY=

# Geminiのキー。Google AI Studio で発行する。無料枠は送った文がGoogleに使われるので、日記を送るのは有料枠だけ
GEMINI_API_KEY=
