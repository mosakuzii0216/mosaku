# ローカル: docker compose の Postgres (localhost:5432)
# 本番：Supabase の Session Pooler 接続文字列(ダッシュボードの Connect から取得)
DATABASE_URL=

# 本番は production。Cookie の　Secure フラグがこれで切り替わる。
NODE_ENV=

# openssl rand -base 64 32 で生成。変えると全Cookieが無効になる
COOKIE_SECRET=

# パスキーのRP ID。ページのドメイン。ローカルはlocalhost、本番はmosaku.jp
RP_ID=

# パスキー検証に使うページのURL。ローカルはhttp://localhost:5173、本番はhttps://mosaku.jp
RP_ORIGIN=

# Googleログイン。Google Cloud → Google Auth Platform → クライアントで発行
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Googleから戻ってくる先。Google側に登録したURIと一字一句同じにする
GOOGLE_REDIRECT_URI=

# ログインが終わった後に戻す画面。ローカルはhttp://localhost:5173、本番はhttps://mosaku.jp
FRONTEND_URL=

# 選べるAI。fake(お試し・お金はかからない)・claude・gemini・openai を、カンマ区切りで書く(例: claude,gemini)
# 最初に書いたAIが、選ぶ箱の初めの値になる。書かなければ、どのAIも「準備中」と断る
AI_PROVIDERS=

# Claudeのキー。Claude Console の API Keys で発行する
ANTHROPIC_API_KEY=

# Geminiのキー。Google AI Studio で発行する。無料枠では、送った日記と会話がGoogleの改善に使われる
GEMINI_API_KEY=

# Geminiのモデル。書かなければgemini-3.8-flash。本番はgemini-3.5-flash-lite(無料枠の一日の回数は500回)
GEMINI_MODEL=

# 控えのGeminiのモデル。本命が混んでいる・30秒で答えないときに頼む。書かなければ控えは無し。本番は控え無し
GEMINI_FALLBACK_MODEL=

# OpenAIのキー。OpenAI Platform の API keys で発行する(前払いのクレジットが要る)
OPENAI_API_KEY=

# 1人が1日(直近24時間)に話せる回数。書かなければ20回
AI_DAILY_LIMIT=

# みんな合わせて1日(直近24時間)に話せる回数。書かなければ200回
AI_TOTAL_DAILY_LIMIT=
