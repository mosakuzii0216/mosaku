// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Memo {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(100)
  content     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  trashedAt   DateTime? @map("trashed_at")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentText String?   @map("content_text")

  @@index([userId])
  @@map("memos")
}

model User {
  id                 String       @id @default(cuid())
  createdAt          DateTime     @default(now()) @map("created_at")
  // 開発者の印。本番では、自分のユーザにだけSQLで付ける
  isDeveloper        Boolean      @default(false) @map("is_developer")
  memos              Memo[]
  passkeys           Passkey[]
  accounts           Account[]
  aiUsages           AiUsage[]
  feedbacks          Feedback[]
  createdInvitations Invitation[] @relation("CreatedInvitations")
  usedInvitation     Invitation?  @relation("UsedInvitation")

  @@map("users")
}

model Passkey {
  // credential ID (base64url)　WebAuthnが世界で一意に発行するのでそのまま主キーにする
  id         String    @id
  userId     String    @map("user_id")
  publicKey  Bytes     @map("public_key")
  // 署名カウンタ。使用上は最大2^32だが、パスキーは基本0を返す。必要になったらBigIntへ移す
  counter    Int       @default(0)
  // 'internal'(この端末) / 'hybrid'(QRで別端末)など
  transports String[]
  // 「Macbook」「iphone」など、複数持つときの見分け用
  name       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Account {
  id                String   @id @default(cuid())
  // どのサービスか。今は"google"だけ
  provider          String
  // そのサービスでの本人ID(googleならsub)。メアドは変わることがあるので、見分けはこちらでする
  providerAccountId String   @map("provider_account_id")
  // 表示用。必須にはしない。
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同じGoogleアカウントが2人のユーザに紐づかないようにする
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// AIと話した記録。1日に話せる回数を数えるために、1回ごとに1行残す
model AiUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 「この人の直近24時間」を数えるので、人と時刻で引けるようにする
  @@index([userId, createdAt])
  @@map("ai_usages")
}

// 目安箱に届いた声。読むのは開発者だけ
model Feedback {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  // 送った人が消えても、声は残す。匿名の人がGoogleでログインすると、元の人は消えるため
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("feedbacks")
}

// 招待コード。1つのコードを使えるのは1人だけ
model Invitation {
  id          String    @id @default(cuid())
  // ハイフン無しの8文字で持つ
  code        String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  // 作ってから1ヶ月。決まりを変えても、配ったコードの期限が変わらないように日付で持つ
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String    @map("created_by_id")
  createdBy   User      @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)
  // 1人が使えるのは1枚だけ。使った人が消えても使った日は残るので、もう一度は使えない
  usedById    String?   @unique @map("used_by_id")
  usedBy      User?     @relation("UsedInvitation", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("invitations")
}
