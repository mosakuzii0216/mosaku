# ローカル: docker compose の Postgres (localhost:5432)
# 本番：Supabase の Session Pooler 接続文字列(ダッシュボードの Connect から取得)
DATABASE_URL=

# 本番は production。Cookie の　Secure フラグがこれで切り替わる。
NODE_ENV=

# openssl rand -base 64 32 で生成。変えると全Cookieが無効になる
COOKIE_SECRET=

# パスキーのRP ID。ページのドメイン。ローカルはlocalhost、本番はmosaku.jp
RP_ID=

# パスキー検証に使うページのURL。ローカルはhttp://localhost:5173、本番はhttps://mosaku.jp
RP_ORIGIN=
